<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DisposableScreenshots.Controls">

    <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Pixel Operator 8</FontFamily>
    <FontFamily x:Key="TitleFont">pack://application:,,,/Assets/Fonts/#04b 30</FontFamily>

    <SolidColorBrush x:Key="NavyBrush" Color="#173A5E" />
    <SolidColorBrush x:Key="NavyDeepBrush" Color="#10263A" />
    <SolidColorBrush x:Key="TealBrush" Color="#1AA6A6" />
    <SolidColorBrush x:Key="SeafoamBrush" Color="#9FD6C9" />
    <SolidColorBrush x:Key="CreamBrush" Color="#F8E3B4" />
    <SolidColorBrush x:Key="CreamLightBrush" Color="#FFF3D4" />
    <SolidColorBrush x:Key="PeachBrush" Color="#F7B36B" />
    <SolidColorBrush x:Key="CoralBrush" Color="#E9734F" />
    <SolidColorBrush x:Key="OrangeBrush" Color="#D65335" />
    <SolidColorBrush x:Key="RedBrush" Color="#B2352E" />
    <SolidColorBrush x:Key="MaroonBrush" Color="#7A2028" />
    <SolidColorBrush x:Key="HoverTintBrush" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="FocusBrush" Color="#173A5E" />

    <Style x:Key="RetroButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PeachBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="controls:ButtonMotion.IsEnabled" Value="True" />
        <Setter Property="controls:ButtonMotion.PressOffset" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{StaticResource MaroonBrush}"
                                CornerRadius="12"
                                Margin="4,4,0,0" />
                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RetroPrimaryButton" TargetType="Button" BasedOn="{StaticResource RetroButton}">
        <Setter Property="Background" Value="{StaticResource CoralBrush}" />
    </Style>

    <Style x:Key="RetroSecondaryButton" TargetType="Button" BasedOn="{StaticResource RetroButton}">
        <Setter Property="Background" Value="{StaticResource SeafoamBrush}" />
    </Style>

    <Style x:Key="RetroGhostButton" TargetType="Button" BasedOn="{StaticResource RetroButton}">
        <Setter Property="Background" Value="{StaticResource CreamLightBrush}" />
    </Style>

    <Style x:Key="RetroDangerButton" TargetType="Button" BasedOn="{StaticResource RetroButton}">
        <Setter Property="Background" Value="{StaticResource OrangeBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}" />
    </Style>

    <Style x:Key="RetroWindowButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="{StaticResource CreamLightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="controls:ButtonMotion.IsEnabled" Value="True" />
        <Setter Property="controls:ButtonMotion.PressOffset" Value="3" />
        <Setter Property="controls:ButtonMotion.HoverMotion" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{StaticResource MaroonBrush}"
                                CornerRadius="8"
                                Margin="3,3,0,0" />
                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="8">
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RetroStepButton"
           TargetType="Button"
           BasedOn="{StaticResource RetroWindowButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="RetroCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="20"
                              Height="20"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center">
                            <Border Background="{StaticResource MaroonBrush}"
                                    CornerRadius="5"
                                    Margin="2,2,0,0" />
                            <Border x:Name="Box"
                                    Background="{StaticResource CreamLightBrush}"
                                    BorderBrush="{StaticResource NavyBrush}"
                                    BorderThickness="2"
                                    CornerRadius="5">
                                <Path x:Name="CheckMark"
                                      Data="M3,8 L7,12 L15,3"
                                      Margin="3"
                                      Stroke="{StaticResource NavyBrush}"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square"
                                      Stretch="Uniform"
                                      Visibility="Collapsed" />
                            </Border>
                            <Border x:Name="HoverTint"
                                    Background="{StaticResource HoverTintBrush}"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverTint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RetroProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="10" />
        <Setter Property="Background" Value="{StaticResource SeafoamBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CoralBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="4"
                                Margin="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RetroTrayMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource CreamLightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="8">
                        <Border Background="{StaticResource MaroonBrush}"
                                CornerRadius="12"
                                Margin="4,4,0,0" />
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="6">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RetroTrayMenuItem" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="14" />
                                </Grid.ColumnDefinitions>

                                <Path x:Name="CheckMark"
                                      Width="12"
                                      Height="12"
                                      Data="M2,7 L6,11 L14,2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="{StaticResource NavyBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square"
                                      Stretch="Uniform"
                                      Visibility="Collapsed" />

                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />

                                <TextBlock Grid.Column="2"
                                           Margin="16,0,6,0"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Opacity="0.55"
                                           Text="{TemplateBinding InputGestureText}" />

                                <Path x:Name="SubmenuArrow"
                                      Grid.Column="3"
                                      Width="5"
                                      Height="9"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L5,4.5 L0,9"
                                      Stroke="{StaticResource NavyBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square"
                                      Stretch="Uniform"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               HorizontalOffset="-2"
                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                               Placement="Right"
                               PopupAnimation="Fade"
                               VerticalOffset="-4">
                            <Grid Margin="8">
                                <Border Background="{StaticResource MaroonBrush}"
                                        CornerRadius="12"
                                        Margin="4,4,0,0" />
                                <Border Background="{StaticResource CreamLightBrush}"
                                        BorderBrush="{StaticResource NavyBrush}"
                                        BorderThickness="2"
                                        CornerRadius="12"
                                        Padding="6">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource CreamBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RetroTraySeparator" TargetType="Separator">
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="2"
                            Background="{StaticResource NavyBrush}"
                            CornerRadius="1"
                            Opacity="0.18" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RetroFrameStyle" TargetType="{x:Type controls:RetroFrame}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RetroFrame}">
                    <Grid Margin="0,0,14,14">
                        <Border Background="{StaticResource MaroonBrush}"
                                CornerRadius="24"
                                Margin="10,10,0,0" />

                        <Border Background="{StaticResource PeachBrush}"
                                BorderBrush="{StaticResource NavyBrush}"
                                BorderThickness="3"
                                CornerRadius="24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="56" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid x:Name="PART_TitleBar"
                                      Grid.Row="0"
                                      Margin="14,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{TemplateBinding Title}"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource PixelFont}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource NavyBrush}"
                                               TextOptions.TextFormattingMode="Display" />

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button x:Name="PART_MinimizeButton"
                                                Style="{StaticResource RetroWindowButton}"
                                                Margin="0,0,6,0"
                                                ToolTip="Minimize">
                                            <Rectangle Width="13"
                                                       Height="3"
                                                       Fill="{StaticResource NavyBrush}" />
                                        </Button>
                                        <Button x:Name="PART_SettingsButton"
                                                Style="{StaticResource RetroWindowButton}"
                                                Margin="0,0,6,0"
                                                ToolTip="Settings">
                                            <Canvas Width="16" Height="16"
                                                    RenderOptions.EdgeMode="Aliased">
                                                <Path Fill="{StaticResource NavyBrush}"
                                                      Data="F0 M6.01,3.2 L6.78,1.11 L9.22,1.11 L9.99,3.2 L12.02,2.27 L13.73,3.98 L12.8,6.01 L14.89,6.78 L14.89,9.22 L12.8,9.99 L13.73,12.02 L12.02,13.73 L9.99,12.8 L9.22,14.89 L6.78,14.89 L6.01,12.8 L3.98,13.73 L2.27,12.02 L3.2,9.99 L1.11,9.22 L1.11,6.78 L3.2,6.01 L2.27,3.98 L3.98,2.27 Z M10.03,8.84 L8.84,10.03 L7.16,10.03 L5.97,8.84 L5.97,7.16 L7.16,5.97 L8.84,5.97 L10.03,7.16 Z" />
                                            </Canvas>
                                        </Button>
                                        <Button x:Name="PART_CloseButton"
                                                Style="{StaticResource RetroWindowButton}"
                                                ToolTip="Close to tray">
                                            <Path Data="M0,0 L12,12 M12,0 L0,12"
                                                  Stroke="{StaticResource NavyBrush}"
                                                  StrokeThickness="2.5"
                                                  StrokeStartLineCap="Square"
                                                  StrokeEndLineCap="Square" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="0"
                                      Height="5"
                                      Margin="10,0,10,0"
                                      VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="{StaticResource TealBrush}" />
                                    <Rectangle Grid.Column="1" Fill="{StaticResource SeafoamBrush}" />
                                    <Rectangle Grid.Column="2" Fill="{StaticResource CreamBrush}" />
                                    <Rectangle Grid.Column="3" Fill="{StaticResource CoralBrush}" />
                                    <Rectangle Grid.Column="4" Fill="{StaticResource RedBrush}" />
                                </Grid>

                                <Border Grid.Row="1"
                                        Margin="10,0,10,10"
                                        Background="{StaticResource CreamBrush}"
                                        BorderBrush="{StaticResource NavyBrush}"
                                        BorderThickness="3"
                                        CornerRadius="16">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
