<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DisposableScreenshots.Controls">

    <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Silkscreen</FontFamily>

    <SolidColorBrush x:Key="NavyBrush" Color="#173A5E" />
    <SolidColorBrush x:Key="NavyDeepBrush" Color="#10263A" />
    <SolidColorBrush x:Key="TealBrush" Color="#1AA6A6" />
    <SolidColorBrush x:Key="SeafoamBrush" Color="#9FD6C9" />
    <SolidColorBrush x:Key="CreamBrush" Color="#F8E3B4" />
    <SolidColorBrush x:Key="CreamLightBrush" Color="#FFF3D4" />
    <SolidColorBrush x:Key="PeachBrush" Color="#F7B36B" />
    <SolidColorBrush x:Key="CoralBrush" Color="#E9734F" />
    <SolidColorBrush x:Key="OrangeBrush" Color="#D65335" />
    <SolidColorBrush x:Key="RedBrush" Color="#B2352E" />
    <SolidColorBrush x:Key="MaroonBrush" Color="#7A2028" />
    <SolidColorBrush x:Key="HoverTintBrush" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="FocusBrush" Color="#173A5E" />

    <Style x:Key="RetroButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PeachBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{StaticResource MaroonBrush}"
                                CornerRadius="12"
                                Margin="4,4,0,0" />
                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                                <Border x:Name="HoverTint"
                                        Background="{StaticResource HoverTintBrush}"
                                        CornerRadius="9"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverTint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="2" Y="2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RetroPrimaryButton" TargetType="Button" BasedOn="{StaticResource RetroButton}">
        <Setter Property="Background" Value="{StaticResource CoralBrush}" />
    </Style>

    <Style x:Key="RetroSecondaryButton" TargetType="Button" BasedOn="{StaticResource RetroButton}">
        <Setter Property="Background" Value="{StaticResource SeafoamBrush}" />
    </Style>

    <Style x:Key="RetroGhostButton" TargetType="Button" BasedOn="{StaticResource RetroButton}">
        <Setter Property="Background" Value="{StaticResource CreamLightBrush}" />
    </Style>

    <Style x:Key="RetroDangerButton" TargetType="Button" BasedOn="{StaticResource RetroButton}">
        <Setter Property="Background" Value="{StaticResource OrangeBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}" />
    </Style>

    <Style x:Key="RetroWindowButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="{StaticResource CreamLightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{StaticResource MaroonBrush}"
                                CornerRadius="8"
                                Margin="3,3,0,0" />
                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="8">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <Border x:Name="HoverTint"
                                        Background="{StaticResource HoverTintBrush}"
                                        CornerRadius="6"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverTint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RetroStepButton"
           TargetType="Button"
           BasedOn="{StaticResource RetroWindowButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="RetroCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="20"
                              Height="20"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center">
                            <Border Background="{StaticResource MaroonBrush}"
                                    CornerRadius="5"
                                    Margin="2,2,0,0" />
                            <Border x:Name="Box"
                                    Background="{StaticResource CreamLightBrush}"
                                    BorderBrush="{StaticResource NavyBrush}"
                                    BorderThickness="2"
                                    CornerRadius="5">
                                <Path x:Name="CheckMark"
                                      Data="M3,8 L7,12 L15,3"
                                      Margin="3"
                                      Stroke="{StaticResource NavyBrush}"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square"
                                      Stretch="Uniform"
                                      Visibility="Collapsed" />
                            </Border>
                            <Border x:Name="HoverTint"
                                    Background="{StaticResource HoverTintBrush}"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverTint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RetroFrameStyle" TargetType="{x:Type controls:RetroFrame}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RetroFrame}">
                    <Grid Margin="0,0,14,14">
                        <Border Background="{StaticResource MaroonBrush}"
                                CornerRadius="24"
                                Margin="10,10,0,0" />

                        <Border Background="{StaticResource PeachBrush}"
                                BorderBrush="{StaticResource NavyBrush}"
                                BorderThickness="3"
                                CornerRadius="24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="56" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid x:Name="PART_TitleBar"
                                      Grid.Row="0"
                                      Margin="14,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{TemplateBinding Title}"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource PixelFont}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource NavyBrush}"
                                               TextOptions.TextFormattingMode="Display" />

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button x:Name="PART_MinimizeButton"
                                                Style="{StaticResource RetroWindowButton}"
                                                Margin="0,0,6,0"
                                                ToolTip="Minimize">
                                            <Rectangle Width="13"
                                                       Height="3"
                                                       Fill="{StaticResource NavyBrush}" />
                                        </Button>
                                        <Button x:Name="PART_SettingsButton"
                                                Style="{StaticResource RetroWindowButton}"
                                                Margin="0,0,6,0"
                                                ToolTip="Settings">
                                            <Canvas Width="14" Height="14">
                                                <Rectangle Canvas.Left="0" Canvas.Top="2" Width="14" Height="2" Fill="{StaticResource NavyBrush}" />
                                                <Rectangle Canvas.Left="2" Canvas.Top="0" Width="4" Height="6" Fill="{StaticResource CreamLightBrush}" Stroke="{StaticResource NavyBrush}" StrokeThickness="1" />
                                                <Rectangle Canvas.Left="0" Canvas.Top="6" Width="14" Height="2" Fill="{StaticResource NavyBrush}" />
                                                <Rectangle Canvas.Left="9" Canvas.Top="4" Width="4" Height="6" Fill="{StaticResource CreamLightBrush}" Stroke="{StaticResource NavyBrush}" StrokeThickness="1" />
                                                <Rectangle Canvas.Left="0" Canvas.Top="10" Width="14" Height="2" Fill="{StaticResource NavyBrush}" />
                                                <Rectangle Canvas.Left="5" Canvas.Top="8" Width="4" Height="6" Fill="{StaticResource CreamLightBrush}" Stroke="{StaticResource NavyBrush}" StrokeThickness="1" />
                                            </Canvas>
                                        </Button>
                                        <Button x:Name="PART_CloseButton"
                                                Style="{StaticResource RetroWindowButton}"
                                                ToolTip="Close to tray">
                                            <Path Data="M0,0 L12,12 M12,0 L0,12"
                                                  Stroke="{StaticResource NavyBrush}"
                                                  StrokeThickness="2.5"
                                                  StrokeStartLineCap="Square"
                                                  StrokeEndLineCap="Square" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="0"
                                      Height="5"
                                      Margin="10,0,10,0"
                                      VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="{StaticResource TealBrush}" />
                                    <Rectangle Grid.Column="1" Fill="{StaticResource SeafoamBrush}" />
                                    <Rectangle Grid.Column="2" Fill="{StaticResource CreamBrush}" />
                                    <Rectangle Grid.Column="3" Fill="{StaticResource CoralBrush}" />
                                    <Rectangle Grid.Column="4" Fill="{StaticResource RedBrush}" />
                                </Grid>

                                <Border Grid.Row="1"
                                        Margin="10,0,10,10"
                                        Background="{StaticResource CreamBrush}"
                                        BorderBrush="{StaticResource NavyBrush}"
                                        BorderThickness="3"
                                        CornerRadius="16">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
