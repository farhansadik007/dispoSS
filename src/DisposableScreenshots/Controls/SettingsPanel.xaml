<UserControl x:Class="DisposableScreenshots.Controls.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DisposableScreenshots.Controls"
             Background="Transparent"
             FontFamily="{StaticResource PixelFont}"
             FontSize="10"
             Foreground="{StaticResource NavyBrush}"
             Focusable="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="HotkeyFieldButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CreamBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
            <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FieldFace"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldFace"
                                        Property="Background"
                                        Value="{StaticResource SeafoamBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldFace"
                                        Property="BorderBrush"
                                        Value="{StaticResource CoralBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SETTINGS"
                           FontFamily="{StaticResource TitleFont}"
                           FontSize="26"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="Aliased" />
                <TextBlock Text="?"
                           FontFamily="{StaticResource TitleFont}"
                           FontSize="26"
                           Foreground="{StaticResource CoralBrush}"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="Aliased" />
            </StackPanel>
            <TextBlock Text="CHANGE THE CAPTURE FLOW."
                       Margin="1,5,0,0"
                       FontSize="10"
                       Opacity="0.65" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource CreamLightBrush}"
                    BorderBrush="{StaticResource NavyBrush}"
                    BorderThickness="2"
                    CornerRadius="12"
                    Padding="10,10">
                <StackPanel>
                    <TextBlock Text="CAPTURE"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource CoralBrush}" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HOTKEY" />
                            <TextBlock Text="CLICK TO REBIND"
                                       Margin="0,2,0,0"
                                       FontSize="9"
                                       Opacity="0.6" />
                        </StackPanel>
                        <Button x:Name="HotkeyButton"
                                Grid.Column="1"
                                Style="{StaticResource HotkeyFieldButton}"
                                AutomationProperties.Name="Change capture hotkey"
                                ToolTip="Click, then press Ctrl and another key. Esc cancels."
                                Click="HotkeyButton_Click"
                                PreviewKeyDown="HotkeyButton_PreviewKeyDown"
                                LostKeyboardFocus="HotkeyButton_LostKeyboardFocus">
                            <TextBlock x:Name="HotkeyText"
                                       FontSize="10" />
                        </Button>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="COUNTDOWN" />
                            <TextBlock Text="BEFORE FREEZE"
                                       Margin="0,2,0,0"
                                       FontSize="9"
                                       Opacity="0.6" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource RetroStepButton}"
                                    AutomationProperties.Name="Previous countdown"
                                    ToolTip="Previous countdown"
                                    Click="DelayPrevious_Click">
                                <TextBlock Text="&lt;"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NavyBrush}" />
                            </Button>
                            <Border MinWidth="38"
                                    Margin="4,0"
                                    Padding="6,4"
                                    Background="{StaticResource CreamBrush}"
                                    BorderBrush="{StaticResource NavyBrush}"
                                    BorderThickness="2"
                                    CornerRadius="7">
                                <TextBlock x:Name="DelayValueText"
                                           Text="3S"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Button Style="{StaticResource RetroStepButton}"
                                    AutomationProperties.Name="Next countdown"
                                    ToolTip="Next countdown"
                                    Click="DelayNext_Click">
                                <TextBlock Text="&gt;"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NavyBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="CopyCheckBox"
                              Content="COPY TO CLIPBOARD"
                              Style="{StaticResource RetroCheckBox}"
                              Margin="0,10,0,0" />
                    <CheckBox x:Name="ShowPreviewCheckBox"
                              Content="SHOW PREVIEW"
                              Style="{StaticResource RetroCheckBox}"
                              Margin="0,8,0,0"
                              Checked="ShowPreviewCheckBox_Checked"
                              Unchecked="ShowPreviewCheckBox_Unchecked" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource CreamLightBrush}"
                    BorderBrush="{StaticResource NavyBrush}"
                    BorderThickness="2"
                    CornerRadius="12"
                    Padding="10,10">
                <StackPanel>
                    <TextBlock Text="PRIVACY"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource CoralBrush}" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CLEAR CLIPBOARD" />
                            <TextBlock Text="IF STILL OURS"
                                       Margin="0,2,0,0"
                                       FontSize="9"
                                       Opacity="0.6" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource RetroStepButton}"
                                    AutomationProperties.Name="Previous clipboard timer"
                                    ToolTip="Previous clipboard timer"
                                    Click="ClipboardPrevious_Click">
                                <TextBlock Text="&lt;"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NavyBrush}" />
                            </Button>
                            <Border MinWidth="38"
                                    Margin="4,0"
                                    Padding="6,4"
                                    Background="{StaticResource CreamBrush}"
                                    BorderBrush="{StaticResource NavyBrush}"
                                    BorderThickness="2"
                                    CornerRadius="7">
                                <TextBlock x:Name="ClipboardValueText"
                                           Text="OFF"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Button Style="{StaticResource RetroStepButton}"
                                    AutomationProperties.Name="Next clipboard timer"
                                    ToolTip="Next clipboard timer"
                                    Click="ClipboardNext_Click">
                                <TextBlock Text="&gt;"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NavyBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PREVIEW TIMEOUT" />
                            <TextBlock Text="HOVER PAUSES IT"
                                       Margin="0,2,0,0"
                                       FontSize="9"
                                       Opacity="0.6" />
                        </StackPanel>
                        <StackPanel x:Name="PreviewStepper"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource RetroStepButton}"
                                    AutomationProperties.Name="Previous preview timeout"
                                    ToolTip="Previous preview timeout"
                                    Click="PreviewPrevious_Click">
                                <TextBlock Text="&lt;"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NavyBrush}" />
                            </Button>
                            <Border MinWidth="38"
                                    Margin="4,0"
                                    Padding="6,4"
                                    Background="{StaticResource CreamBrush}"
                                    BorderBrush="{StaticResource NavyBrush}"
                                    BorderThickness="2"
                                    CornerRadius="7">
                                <TextBlock x:Name="PreviewValueText"
                                           Text="8S"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Button Style="{StaticResource RetroStepButton}"
                                    AutomationProperties.Name="Next preview timeout"
                                    ToolTip="Next preview timeout"
                                    Click="PreviewNext_Click">
                                <TextBlock Text="&gt;"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NavyBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Height="2"
                            Margin="0,10,0,8"
                            Background="{StaticResource NavyBrush}"
                            Opacity="0.15" />

                    <TextBlock Text="STARTUP"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource CoralBrush}" />
                    <CheckBox x:Name="StartupCheckBox"
                              Content="START WITH WINDOWS"
                              Style="{StaticResource RetroCheckBox}"
                              Margin="0,8,0,0" />
                    <TextBlock x:Name="DevNote"
                               Text="DISABLED IN DEV MODE."
                               Margin="0,6,0,0"
                               FontSize="9"
                               Opacity="0.6"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VersionText"
                       VerticalAlignment="Center"
                       FontSize="10"
                       Opacity="0.55" />
            <Button Grid.Column="1"
                    Content="CANCEL"
                    Style="{StaticResource RetroGhostButton}"
                    controls:ButtonMotion.HoverMotion="False"
                    Padding="14,8"
                    Margin="0,0,7,0"
                    FontSize="11"
                    Click="CancelButton_Click" />
            <Button Grid.Column="2"
                    Content="SAVE"
                    Style="{StaticResource RetroPrimaryButton}"
                    controls:ButtonMotion.HoverMotion="False"
                    Padding="14,8"
                    FontSize="11"
                    Click="SaveButton_Click" />
        </Grid>
    </Grid>
</UserControl>
