<Window x:Class="DisposableScreenshots.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Disposable Screenshots"
        Width="580"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1B1F"
        Foreground="#FFF5F5F7"
        FontFamily="Segoe UI"
        FontSize="13"
        SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF26262B" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FFF0F0F2" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44"
                    Height="44"
                    CornerRadius="10"
                    Background="#FFFF7A45"
                    VerticalAlignment="Top">
                <TextBlock Text="DS"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#FF1B1B1F" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Disposable Screenshots"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="Capture now. Keep it only if you want it."
                           Margin="0,3,0,0"
                           Foreground="#99FFFFFF" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="CAPTURE" Style="{StaticResource SectionLabelStyle}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Content="Capture region"
                               Appearance="Primary"
                               Height="44"
                               HorizontalAlignment="Stretch"
                               Click="CaptureRegion_Click" />
                    <ui:Button Grid.Column="1"
                               Content="Capture full screen"
                               Height="44"
                               Margin="8,0,0,0"
                               HorizontalAlignment="Stretch"
                               Click="CaptureFullScreen_Click" />
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Global hotkey" Style="{StaticResource RowLabelStyle}" />
                    <Border Grid.Column="1"
                            Background="#FF1B1B1F"
                            CornerRadius="6"
                            Padding="10,6">
                        <TextBlock x:Name="HotkeyText"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="#FFFFB38F" />
                    </Border>
                </Grid>

                <TextBlock Text="The window hides while a capture is running, then comes back. Press the hotkey again during the countdown to cancel."
                           Style="{StaticResource HintStyle}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="OUTPUT" Style="{StaticResource SectionLabelStyle}" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Clipboard" Style="{StaticResource RowLabelStyle}" />
                    <TextBlock Grid.Column="1"
                               Text="Every capture is copied here."
                               Foreground="#CCFFFFFF"
                               TextWrapping="Wrap" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Disk" Style="{StaticResource RowLabelStyle}" />
                    <TextBlock Grid.Column="1"
                               Text="Only when you click Save in the preview."
                               Foreground="#CCFFFFFF"
                               TextWrapping="Wrap" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Save folder" Style="{StaticResource RowLabelStyle}" />
                    <TextBlock Grid.Column="1"
                               Text="You choose it in the Save dialog."
                               Foreground="#CCFFFFFF"
                               TextWrapping="Wrap" />
                </Grid>

                <TextBlock Text="The preview appears in the bottom-right corner. Hover over it to pause the close timer."
                           Style="{StaticResource HintStyle}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VersionText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#66FFFFFF" />
            <ui:Button Grid.Column="1"
                       Content="Settings"
                       Padding="18,8"
                       Margin="0,0,8,0"
                       Click="SettingsButton_Click" />
            <ui:Button Grid.Column="2"
                       Content="Hide to tray"
                       Padding="18,8"
                       Margin="0,0,8,0"
                       Click="HideButton_Click" />
            <ui:Button Grid.Column="3"
                       Content="Exit"
                       Appearance="Danger"
                       Padding="18,8"
                       Click="ExitButton_Click" />
        </Grid>
    </Grid>
</Window>
