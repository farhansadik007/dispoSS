<Window x:Class="DisposableScreenshots.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DisposableScreenshots.Controls"
        Title="dispoSS"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource NavyBrush}"
        FontFamily="{StaticResource PixelFont}"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        SourceInitialized="OnSourceInitialized"
        PreviewKeyDown="OnPreviewKeyDown">
    <controls:RetroFrame Title="dispoSS"
                         Style="{StaticResource RetroFrameStyle}"
                         SettingsRequested="SettingsButton_Click">
        <Grid x:Name="ViewHost"
              Height="380"
              ClipToBounds="True">
            <Grid x:Name="CaptureView">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CaptureTranslate" />
                </Grid.RenderTransform>
                <Grid Margin="24,22,24,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock AutomationProperties.Name="dispoSS"
                                       FontFamily="{StaticResource TitleFont}"
                                       FontSize="42"
                                       Foreground="{StaticResource NavyBrush}"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="Aliased">
                                <Run Text="D" /><Run Text="ISPO" FontSize="30" /><Run Text="SS" /><Run Text="?" Foreground="{StaticResource CoralBrush}" />
                            </TextBlock>
                            <TextBlock Text="QUICK. PRIVATE. GONE."
                                       Margin="2,8,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource NavyBrush}"
                                       Opacity="0.8" />
                        </StackPanel>

                        <Canvas Grid.Column="1"
                                Width="150"
                                Height="94"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center">
                            <Image Canvas.Left="35"
                                   Canvas.Top="1"
                                   Width="80"
                                   Height="92"
                                   Source="/Assets/trash-can.png"
                                   Stretch="None"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   SnapsToDevicePixels="True" />
                        </Canvas>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource RetroPrimaryButton}"
                                Height="72"
                                Margin="0,0,8,0"
                                Click="CaptureRegion_Click">
                            <StackPanel>
                                <TextBlock Text="CAPTURE REGION"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="HotkeyText"
                                           Margin="0,5,0,0"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Opacity="0.75" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Style="{StaticResource RetroSecondaryButton}"
                                Height="72"
                                Margin="8,0,0,0"
                                Click="CaptureFullScreen_Click">
                            <StackPanel>
                                <TextBlock Text="FULL SCREEN"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="ALL MONITORS"
                                           Margin="0,5,0,0"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Opacity="0.75" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="0,0,0,18"
                            Padding="14,11"
                            Background="{StaticResource SeafoamBrush}"
                            BorderBrush="{StaticResource NavyBrush}"
                            BorderThickness="2"
                            CornerRadius="12">
                        <TextBlock Text="CLIPBOARD FIRST  •  NO HISTORY  •  SAVE ONLY IF YOU WANT IT"
                                   FontSize="9"
                                   Foreground="{StaticResource NavyBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Grid.Row="3"
                               Text="THE WINDOW HIDES DURING A CAPTURE."
                               FontSize="8"
                               Opacity="0.5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="VersionText"
                                   VerticalAlignment="Center"
                                   FontSize="8"
                                   Foreground="{StaticResource NavyBrush}"
                                   Opacity="0.55" />

                        <Button Grid.Column="1"
                                Content="SETTINGS"
                                Style="{StaticResource RetroGhostButton}"
                                Padding="12,8"
                                Margin="0,0,7,0"
                                FontSize="10"
                                Click="SettingsButton_Click" />
                        <Button Grid.Column="2"
                                Content="HIDE TO TRAY"
                                Style="{StaticResource RetroGhostButton}"
                                Padding="12,8"
                                Margin="0,0,7,0"
                                FontSize="10"
                                Click="HideButton_Click" />
                        <Button Grid.Column="3"
                                Content="EXIT"
                                Style="{StaticResource RetroDangerButton}"
                                Padding="12,8"
                                FontSize="10"
                                Click="ExitButton_Click" />
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsView"
                  Visibility="Collapsed"
                  Opacity="0"
                  Background="Transparent">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SettingsTranslate" />
                </Grid.RenderTransform>
                <controls:SettingsPanel x:Name="SettingsPanel"
                                        SaveRequested="SettingsPanel_SaveRequested"
                                        CancelRequested="SettingsPanel_CancelRequested" />
            </Grid>
        </Grid>
    </controls:RetroFrame>
</Window>
