<Window x:Class="DisposableScreenshots.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DisposableScreenshots.Controls"
        Title="dispoSS"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource NavyBrush}"
        FontFamily="{StaticResource PixelFont}"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        SourceInitialized="OnSourceInitialized"
        PreviewKeyDown="OnPreviewKeyDown">
    <controls:RetroFrame Title="dispoSS"
                         Style="{StaticResource RetroFrameStyle}"
                         SettingsRequested="SettingsButton_Click">
        <Grid x:Name="ViewHost"
              Height="380"
              ClipToBounds="True">
            <Grid x:Name="CaptureView">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CaptureTranslate" />
                </Grid.RenderTransform>
                <Grid Margin="24,22,24,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock AutomationProperties.Name="dispoSS"
                                       FontFamily="{StaticResource TitleFont}"
                                       FontSize="42"
                                       Foreground="{StaticResource NavyBrush}"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="Aliased">
                                <Run Text="D" /><Run Text="ISPO" FontSize="30" /><Run Text="SS" /><Run Text="?" Foreground="{StaticResource CoralBrush}" />
                            </TextBlock>
                            <TextBlock Text="QUICK. PRIVATE. GONE."
                                       Margin="2,8,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource NavyBrush}"
                                       Opacity="0.8" />
                        </StackPanel>

                        <Canvas Grid.Column="1"
                                Width="150"
                                Height="94"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center"
                                ClipToBounds="False">
                            <Canvas Width="75"
                                    Height="47"
                                    RenderOptions.EdgeMode="Aliased">
                                <Canvas.RenderTransform>
                                    <ScaleTransform ScaleX="2" ScaleY="2" />
                                </Canvas.RenderTransform>

                                <Canvas.Resources>
                                    <SolidColorBrush x:Key="BinBodyBrush" Color="#1B3F7A" />
                                    <SolidColorBrush x:Key="BinBodyDarkBrush" Color="#122F5C" />
                                    <SolidColorBrush x:Key="BinBodyLightBrush" Color="#2A63B0" />
                                    <SolidColorBrush x:Key="BinBodyHiBrush" Color="#4A9AEA" />
                                    <SolidColorBrush x:Key="BinRibBrush" Color="#0C2547" />
                                    <SolidColorBrush x:Key="BinOutlineBrush" Color="#08172E" />
                                    <SolidColorBrush x:Key="BinOpeningBrush" Color="#06152B" />
                                    <SolidColorBrush x:Key="BinRimBrush" Color="#3B82D6" />
                                    <SolidColorBrush x:Key="BinRimFaceBrush" Color="#1E4D8F" />

                                    <PathGeometry x:Key="CanBodyGeometry"
                                                  Figures="M26,20 L26,27 L27,27 L27,34 L28,34 L28,41 L29,41 L29,45 L45,45 L45,41 L46,41 L46,34 L47,34 L47,27 L48,27 L48,20 Z" />

                                    <Storyboard x:Key="TrashLoop" Duration="0:0:3" RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Photo"
                                                                       Storyboard.TargetProperty="(Canvas.Top)">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="-2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.65" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.75" Value="4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.85" Value="7" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.95" Value="10" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.05" Value="13" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.15" Value="16" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.25" Value="19" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.35" Value="20" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="20" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.3" Value="-2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="-2" />
                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Photo"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.1" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.3" Value="0" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:2.6" Value="1">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <SineEase EasingMode="EaseOut" />
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sparkles"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.25" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.35" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.65" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </Canvas.Resources>

                                <Canvas.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard Storyboard="{StaticResource TrashLoop}" />
                                    </EventTrigger>
                                </Canvas.Triggers>

                                <Path Fill="#3A173A5E"
                                      Data="M12,46 L63,46 L64,47 L11,47 Z" />
                                <Path Fill="#5A173A5E"
                                      Data="M20,45 L56,45 L58,46 L53,47 L27,47 L22,46 Z" />
                                <Path Fill="#4A10263A"
                                      Data="M28,46 L48,46 L50,47 L26,47 Z" />

                                <Canvas x:Name="CanBack" Panel.ZIndex="0">
                                    <Rectangle Canvas.Left="23" Canvas.Top="12" Width="28" Height="8"
                                               Fill="{StaticResource BinOutlineBrush}" />
                                    <Rectangle Canvas.Left="24" Canvas.Top="13" Width="26" Height="2"
                                               Fill="{StaticResource BinRimBrush}" />
                                    <Rectangle Canvas.Left="24" Canvas.Top="13" Width="26" Height="1"
                                               Fill="{StaticResource BinBodyHiBrush}" />
                                    <Rectangle Canvas.Left="24" Canvas.Top="14" Width="3" Height="3"
                                               Fill="{StaticResource BinRimBrush}" />
                                    <Rectangle Canvas.Left="47" Canvas.Top="14" Width="3" Height="3"
                                               Fill="{StaticResource BinRimBrush}" />
                                    <Rectangle Canvas.Left="27" Canvas.Top="14" Width="20" Height="1"
                                               Fill="{StaticResource BinOpeningBrush}" />
                                    <Rectangle Canvas.Left="25" Canvas.Top="15" Width="24" Height="2"
                                               Fill="{StaticResource BinOpeningBrush}" />
                                    <Rectangle Canvas.Left="26" Canvas.Top="17" Width="22" Height="1"
                                               Fill="{StaticResource BinOpeningBrush}" />
                                    <Rectangle Canvas.Left="29" Canvas.Top="15" Width="16" Height="2"
                                               Fill="#040F1F" />
                                    <Rectangle Canvas.Left="25" Canvas.Top="14" Width="1" Height="4"
                                               Fill="{StaticResource BinBodyDarkBrush}" />
                                    <Rectangle Canvas.Left="48" Canvas.Top="14" Width="1" Height="4"
                                               Fill="{StaticResource BinBodyDarkBrush}" />
                                </Canvas>

                                <Canvas x:Name="Photo"
                                        Panel.ZIndex="2"
                                        Canvas.Left="29"
                                        Canvas.Top="-2"
                                        Width="16"
                                        Height="11">
                                    <Rectangle Width="16" Height="11" Fill="{StaticResource NavyBrush}" />
                                    <Rectangle Canvas.Left="2" Canvas.Top="2" Width="12" Height="7"
                                               Fill="{StaticResource CreamLightBrush}" />
                                    <Path Fill="{StaticResource NavyBrush}"
                                          Data="M2,9 L2,7 L3,7 L3,6 L4,6 L4,7 L5,7 L5,8 L6,8 L6,9 L7,9 L7,8 L8,8 L8,7 L9,7 L9,8 L10,8 L10,9 L12,9 L12,10 L2,10 Z" />
                                    <Rectangle Canvas.Left="11" Canvas.Top="3" Width="2" Height="2"
                                               Fill="{StaticResource CoralBrush}" />
                                </Canvas>

                                <Canvas x:Name="CanFront" Panel.ZIndex="3">
                                    <Path Data="{StaticResource CanBodyGeometry}"
                                          Fill="{StaticResource BinBodyBrush}" />
                                    <Canvas Clip="{StaticResource CanBodyGeometry}">
                                        <Rectangle Canvas.Left="26" Canvas.Top="20" Width="4" Height="25"
                                                   Fill="{StaticResource BinBodyDarkBrush}" Opacity="0.85" />
                                        <Rectangle Canvas.Left="44" Canvas.Top="20" Width="5" Height="25"
                                                   Fill="{StaticResource BinBodyLightBrush}" Opacity="0.9" />
                                        <Rectangle Canvas.Left="30" Canvas.Top="20" Width="2" Height="25"
                                                   Fill="{StaticResource BinRibBrush}" />
                                        <Rectangle Canvas.Left="34" Canvas.Top="20" Width="2" Height="25"
                                                   Fill="{StaticResource BinRibBrush}" />
                                        <Rectangle Canvas.Left="38" Canvas.Top="20" Width="2" Height="25"
                                                   Fill="{StaticResource BinRibBrush}" />
                                        <Rectangle Canvas.Left="42" Canvas.Top="20" Width="2" Height="25"
                                                   Fill="{StaticResource BinRibBrush}" />
                                        <Rectangle Canvas.Left="44" Canvas.Top="20" Width="1" Height="25"
                                                   Fill="{StaticResource BinBodyHiBrush}" />
                                        <Rectangle Canvas.Left="26" Canvas.Top="20" Width="22" Height="2"
                                                   Fill="{StaticResource BinBodyDarkBrush}" Opacity="0.85" />
                                        <Rectangle Canvas.Left="26" Canvas.Top="43" Width="22" Height="2"
                                                   Fill="{StaticResource BinBodyDarkBrush}" Opacity="0.7" />
                                    </Canvas>
                                    <Path Data="{StaticResource CanBodyGeometry}"
                                          Stroke="{StaticResource BinOutlineBrush}"
                                          StrokeThickness="1"
                                          Fill="Transparent" />
                                    <Rectangle Canvas.Left="23" Canvas.Top="17" Width="28" Height="3"
                                               Fill="{StaticResource BinOutlineBrush}" />
                                    <Rectangle Canvas.Left="24" Canvas.Top="17" Width="26" Height="2"
                                               Fill="{StaticResource BinRimFaceBrush}" />
                                    <Rectangle Canvas.Left="25" Canvas.Top="17" Width="24" Height="1"
                                               Fill="{StaticResource BinRimBrush}" />
                                    <Rectangle Canvas.Left="24" Canvas.Top="19" Width="26" Height="1"
                                               Fill="{StaticResource BinOutlineBrush}" />
                                </Canvas>

                                <Canvas x:Name="Sparkles" Panel.ZIndex="4" Opacity="0">
                                    <Rectangle Canvas.Left="18" Canvas.Top="7" Width="1" Height="5"
                                               Fill="{StaticResource CoralBrush}" />
                                    <Rectangle Canvas.Left="16" Canvas.Top="9" Width="5" Height="1"
                                               Fill="{StaticResource CoralBrush}" />
                                    <Rectangle Canvas.Left="55" Canvas.Top="11" Width="1" Height="5"
                                               Fill="{StaticResource BinBodyHiBrush}" />
                                    <Rectangle Canvas.Left="53" Canvas.Top="13" Width="5" Height="1"
                                               Fill="{StaticResource BinBodyHiBrush}" />
                                    <Rectangle Canvas.Left="59" Canvas.Top="7" Width="2" Height="2"
                                               Fill="{StaticResource CoralBrush}" />
                                </Canvas>
                            </Canvas>
                        </Canvas>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource RetroPrimaryButton}"
                                Height="72"
                                Margin="0,0,8,0"
                                Click="CaptureRegion_Click">
                            <StackPanel>
                                <TextBlock Text="CAPTURE REGION"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="HotkeyText"
                                           Margin="0,5,0,0"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Opacity="0.75" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Style="{StaticResource RetroSecondaryButton}"
                                Height="72"
                                Margin="8,0,0,0"
                                Click="CaptureFullScreen_Click">
                            <StackPanel>
                                <TextBlock Text="FULL SCREEN"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="ALL MONITORS"
                                           Margin="0,5,0,0"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Opacity="0.75" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="0,0,0,18"
                            Padding="14,11"
                            Background="{StaticResource SeafoamBrush}"
                            BorderBrush="{StaticResource NavyBrush}"
                            BorderThickness="2"
                            CornerRadius="12">
                        <TextBlock Text="CLIPBOARD FIRST  •  NO HISTORY  •  SAVE ONLY IF YOU WANT IT"
                                   FontSize="9"
                                   Foreground="{StaticResource NavyBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Grid.Row="3"
                               Text="THE WINDOW HIDES DURING A CAPTURE."
                               FontSize="8"
                               Opacity="0.5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="VersionText"
                                   VerticalAlignment="Center"
                                   FontSize="8"
                                   Foreground="{StaticResource NavyBrush}"
                                   Opacity="0.55" />

                        <Button Grid.Column="1"
                                Content="SETTINGS"
                                Style="{StaticResource RetroGhostButton}"
                                Padding="12,8"
                                Margin="0,0,7,0"
                                FontSize="10"
                                Click="SettingsButton_Click" />
                        <Button Grid.Column="2"
                                Content="HIDE TO TRAY"
                                Style="{StaticResource RetroGhostButton}"
                                Padding="12,8"
                                Margin="0,0,7,0"
                                FontSize="10"
                                Click="HideButton_Click" />
                        <Button Grid.Column="3"
                                Content="EXIT"
                                Style="{StaticResource RetroDangerButton}"
                                Padding="12,8"
                                FontSize="10"
                                Click="ExitButton_Click" />
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsView"
                  Visibility="Collapsed"
                  Opacity="0"
                  Background="Transparent">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SettingsTranslate" />
                </Grid.RenderTransform>
                <controls:SettingsPanel x:Name="SettingsPanel"
                                        SaveRequested="SettingsPanel_SaveRequested"
                                        CancelRequested="SettingsPanel_CancelRequested" />
            </Grid>
        </Grid>
    </controls:RetroFrame>
</Window>
