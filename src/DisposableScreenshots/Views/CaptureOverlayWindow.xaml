<Window x:Class="DisposableScreenshots.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DisposableScreenshots.Views"
        Title="Select a region"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="True">
    <Grid Background="Transparent">
        <local:SelectionCanvas x:Name="SelectionSurface" />
    </Grid>
</Window>
