<Window x:Class="DisposableScreenshots.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot preview"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Foreground="{StaticResource NavyBrush}"
        FontFamily="{StaticResource PixelFont}"
        FontSize="10"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Opacity="0">
    <Grid Margin="16">
        <Border Background="{StaticResource MaroonBrush}"
                CornerRadius="20"
                Margin="5,5,0,0" />

        <Border Background="{StaticResource CreamBrush}"
                BorderBrush="{StaticResource NavyBrush}"
                BorderThickness="3"
                CornerRadius="20"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PREVIEW"
                                   FontSize="24"
                                   FontWeight="Bold" />
                        <TextBlock Text="?"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource CoralBrush}" />
                    </StackPanel>

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="7,3"
                            Background="{StaticResource SeafoamBrush}"
                            BorderBrush="{StaticResource NavyBrush}"
                            BorderThickness="2"
                            CornerRadius="7">
                        <TextBlock Text="NOT SAVED"
                                   FontSize="8" />
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        MaxHeight="210"
                        Background="{StaticResource NavyDeepBrush}"
                        BorderBrush="{StaticResource NavyBrush}"
                        BorderThickness="2"
                        CornerRadius="12"
                        ClipToBounds="True">
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Row="2" Margin="2,10,2,10">
                    <TextBlock x:Name="StatusText"
                               Text="Copied to clipboard"
                               FontSize="12"
                               FontWeight="Bold" />
                    <TextBlock x:Name="MetaText"
                               Margin="0,2,0,0"
                               FontSize="8"
                               Opacity="0.65" />
                    <TextBlock x:Name="AutoCloseText"
                               Margin="0,4,0,0"
                               FontSize="8"
                               Opacity="0.55" />
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="KEEP IT OR LOSE IT"
                               VerticalAlignment="Center"
                               FontSize="8"
                               Opacity="0.55" />

                    <Button x:Name="CopyButton"
                            Grid.Column="1"
                            Content="COPY"
                            Style="{StaticResource RetroGhostButton}"
                            Padding="11,7"
                            Margin="0,0,6,0"
                            FontSize="9"
                            Click="CopyButton_Click" />
                    <Button x:Name="SaveButton"
                            Grid.Column="2"
                            Content="SAVE"
                            Style="{StaticResource RetroPrimaryButton}"
                            Padding="11,7"
                            Margin="0,0,6,0"
                            FontSize="9"
                            Click="SaveButton_Click" />
                    <Button x:Name="DiscardButton"
                            Grid.Column="3"
                            Content="DISCARD"
                            Style="{StaticResource RetroDangerButton}"
                            Padding="11,7"
                            FontSize="9"
                            Click="DiscardButton_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
