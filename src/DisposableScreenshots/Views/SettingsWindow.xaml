<Window x:Class="DisposableScreenshots.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Disposable Screenshots"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1B1F"
        Foreground="#FFF5F5F7"
        FontFamily="Segoe UI"
        FontSize="13"
        SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF26262B" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FFF0F0F2" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44"
                    Height="44"
                    CornerRadius="10"
                    Background="#FFFF7A45"
                    VerticalAlignment="Top">
                <TextBlock Text="DS"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#FF1B1B1F" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Disposable Screenshots"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="Quick, ephemeral captures with a countdown."
                           Margin="0,3,0,0"
                           Foreground="#99FFFFFF" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="CAPTURE" Style="{StaticResource SectionLabelStyle}" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Global hotkey" Style="{StaticResource RowLabelStyle}" />
                        <TextBlock Text="Fixed for the first build; editable next."
                                   Style="{StaticResource HintStyle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#FF1B1B1F"
                            CornerRadius="6"
                            Padding="10,6"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="HotkeyText"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="#FFFFB38F" />
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Countdown delay" Style="{StaticResource RowLabelStyle}" />
                        <TextBlock Text="Time to arrange the screen before it freezes."
                                   Style="{StaticResource HintStyle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <ComboBox x:Name="DelayComboBox"
                              Grid.Column="1"
                              Width="150"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              VerticalAlignment="Center" />
                </Grid>

                <CheckBox x:Name="CopyCheckBox"
                          Content="Copy screenshot to clipboard automatically"
                          Margin="0,2,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Show preview" Style="{StaticResource RowLabelStyle}" />
                        <TextBlock Text="A small toast with Save and Discard actions."
                                   Style="{StaticResource HintStyle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <CheckBox x:Name="ShowPreviewCheckBox"
                              Grid.Column="1"
                              Content="Enabled"
                              VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="PRIVACY" Style="{StaticResource SectionLabelStyle}" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Clear clipboard" Style="{StaticResource RowLabelStyle}" />
                        <TextBlock Text="Only clears the image if it is still ours."
                                   Style="{StaticResource HintStyle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <ComboBox x:Name="ClipboardClearComboBox"
                              Grid.Column="1"
                              Width="150"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              VerticalAlignment="Center" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Preview timeout" Style="{StaticResource RowLabelStyle}" />
                        <TextBlock Text="Hovering over the toast pauses it."
                                   Style="{StaticResource HintStyle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <ComboBox x:Name="PreviewComboBox"
                              Grid.Column="1"
                              Width="150"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="STARTUP" Style="{StaticResource SectionLabelStyle}" />
                <CheckBox x:Name="StartupCheckBox"
                          Content="Start Disposable Screenshots with Windows" />
                <TextBlock x:Name="DevNote"
                           Text="Startup changes are disabled while running in dev mode."
                           Style="{StaticResource HintStyle}"
                           Margin="0,8,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VersionText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#66FFFFFF" />
            <ui:Button Grid.Column="1"
                       Content="Cancel"
                       Padding="18,8"
                       Margin="0,0,8,0"
                       Click="CancelButton_Click" />
            <ui:Button Grid.Column="2"
                       Content="Save"
                       Appearance="Primary"
                       Padding="18,8"
                       Click="SaveButton_Click" />
        </Grid>
    </Grid>
</Window>
