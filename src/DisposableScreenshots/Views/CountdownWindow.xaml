<Window x:Class="DisposableScreenshots.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get ready"
        Width="240"
        Height="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        IsHitTestVisible="False"
        Focusable="False"
        Foreground="{StaticResource NavyBrush}"
        FontFamily="{StaticResource PixelFont}"
        FontSize="11"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Border Background="{StaticResource MaroonBrush}"
                CornerRadius="30"
                Margin="8,8,0,0" />

        <Border Background="{StaticResource CreamBrush}"
                BorderBrush="{StaticResource NavyBrush}"
                BorderThickness="3"
                CornerRadius="30"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Border Width="28" Height="4" Margin="2,0" Background="{StaticResource TealBrush}" CornerRadius="2" />
                    <Border Width="28" Height="4" Margin="2,0" Background="{StaticResource SeafoamBrush}" CornerRadius="2" />
                    <Border Width="28" Height="4" Margin="2,0" Background="{StaticResource PeachBrush}" CornerRadius="2" />
                    <Border Width="28" Height="4" Margin="2,0" Background="{StaticResource CoralBrush}" CornerRadius="2" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="CountdownText"
                               Text="3"
                               HorizontalAlignment="Center"
                               FontSize="76"
                               FontWeight="Bold"
                               Foreground="{StaticResource CoralBrush}" />
                    <TextBlock Text="GET READY"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"
                               FontSize="12"
                               FontWeight="Bold" />
                    <ProgressBar x:Name="CountdownProgress"
                                 Width="140"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="0"
                                 Style="{StaticResource RetroProgressBar}" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="PRESS THE HOTKEY AGAIN TO CANCEL"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           FontSize="10"
                           Opacity="0.55" />
            </Grid>
        </Border>
    </Grid>
</Window>
