<Window x:Class="DisposableScreenshots.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get ready"
        Width="240"
        Height="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        IsHitTestVisible="False"
        Focusable="False">
    <Grid>
        <Border Background="#E6121216"
                CornerRadius="28"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="CountdownText"
                           Text="3"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="86"
                           FontWeight="Bold"
                           Foreground="#FFFF7A45" />
                <TextBlock Text="Get ready"
                           HorizontalAlignment="Center"
                           Margin="0,-4,0,12"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           Foreground="#FFF4F4F6" />
                <ProgressBar x:Name="CountdownProgress"
                             Width="120"
                             Height="4"
                             Minimum="0"
                             Maximum="1"
                             Value="0"
                             Foreground="#FFFF7A45"
                             Background="#33FFFFFF"
                             BorderThickness="0" />
                <TextBlock Text="Press the hotkey again to cancel"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           Foreground="#99FFFFFF" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
