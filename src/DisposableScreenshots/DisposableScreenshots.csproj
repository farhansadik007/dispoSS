<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>dispoSS</AssemblyName>
    <RootNamespace>DisposableScreenshots</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <Version>1.0.0</Version>
    <AssemblyTitle>dispoSS</AssemblyTitle>
    <Product>dispoSS</Product>
    <Authors>dispoSS</Authors>
    <Description>dispoSS - a disposable screenshot tool with a countdown timer.</Description>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.9169" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\home-backdrop.png" />
    <Resource Include="Assets\farhan-sadik.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\PixelOperator-CC0.txt" />
    <Watch Include="**\*.xaml" />
  </ItemGroup>

</Project>
